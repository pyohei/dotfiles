#!/usr/bin/env node
import { createSign } from "node:crypto";
import { readFile, readdir } from "node:fs/promises";
import os from "node:os";
import path from "node:path";

const CONFIG_DIR = "~/.config/pyohei-ai";
const APPS_DIR = "apps";
const LEGACY_CONFIG = "app.env";
const DEFAULT_APP = "default";

function fail(message) {
  console.error(`pyohei-ai: ${message}`);
  process.exit(1);
}

function expandHome(value) {
  if (!value) return value;
  if (value === "~") return os.homedir();
  if (value.startsWith("~/")) return path.join(os.homedir(), value.slice(2));
  return value;
}

function configDir() {
  return expandHome(process.env.PYOHEI_AI_CONFIG_DIR || CONFIG_DIR);
}

function parseEnv(text) {
  const env = {};
  for (const rawLine of text.split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith("#")) continue;

    const index = line.indexOf("=");
    if (index === -1) continue;

    const key = line.slice(0, index).trim();
    const value = line.slice(index + 1).trim();
    env[key] = value.replace(/^['"]|['"]$/g, "");
  }
  return env;
}

function base64url(value) {
  return Buffer.from(value)
    .toString("base64")
    .replace(/=/g, "")
    .replace(/\+/g, "-")
    .replace(/\//g, "_");
}

function required(env, key, appName) {
  const value = env[key];
  if (!value) fail(`Missing ${key} for app "${appName}"`);
  return value;
}

// Resolution order:
//   1. $GITHUB_APP_CONFIG_PATH (explicit file, overrides the app name)
//   2. <config>/apps/<name>.env
//   3. <config>/app.env  -- only for the default app, kept for compatibility
async function resolveConfigPath(appName) {
  const override = process.env.GITHUB_APP_CONFIG_PATH;
  if (override) return expandHome(override);

  const dir = configDir();
  const scoped = path.join(dir, APPS_DIR, `${appName}.env`);
  try {
    await readFile(scoped, "utf8");
    return scoped;
  } catch (err) {
    if (err.code !== "ENOENT") throw err;
  }

  if (appName === DEFAULT_APP) return path.join(dir, LEGACY_CONFIG);
  fail(`Unknown app "${appName}" (expected ${scoped}). Run \`pyohei-ai list\`.`);
}

async function loadApp(appName) {
  const configPath = await resolveConfigPath(appName);
  let text;
  try {
    text = await readFile(configPath, "utf8");
  } catch (err) {
    if (err.code === "ENOENT") fail(`Config not found: ${configPath}`);
    throw err;
  }
  const config = parseEnv(text);
  return {
    name: appName,
    configPath,
    appId: required(config, "GITHUB_APP_ID", appName),
    installationId: required(config, "GITHUB_APP_INSTALLATION_ID", appName),
    privateKeyPath: expandHome(
      required(config, "GITHUB_APP_PRIVATE_KEY_PATH", appName),
    ),
  };
}

async function listApps() {
  const dir = configDir();
  const names = new Set();

  try {
    const entries = await readdir(path.join(dir, APPS_DIR));
    for (const entry of entries) {
      if (entry.endsWith(".env")) names.add(entry.slice(0, -4));
    }
  } catch (err) {
    if (err.code !== "ENOENT") throw err;
  }

  if (!names.has(DEFAULT_APP)) {
    try {
      await readFile(path.join(dir, LEGACY_CONFIG), "utf8");
      names.add(DEFAULT_APP);
    } catch (err) {
      if (err.code !== "ENOENT") throw err;
    }
  }

  return [...names].sort();
}

async function mintToken(app) {
  const privateKey = await readFile(app.privateKeyPath, "utf8");

  const now = Math.floor(Date.now() / 1000);
  const header = base64url(JSON.stringify({ alg: "RS256", typ: "JWT" }));
  const payload = base64url(JSON.stringify({
    iat: now - 60,
    exp: now + 540,
    iss: app.appId,
  }));
  const input = `${header}.${payload}`;

  const sign = createSign("RSA-SHA256");
  sign.update(input);
  const signature = sign.sign(privateKey, "base64url");
  const jwt = `${input}.${signature}`;

  const response = await fetch(
    `https://api.github.com/app/installations/${app.installationId}/access_tokens`,
    {
      method: "POST",
      headers: {
        Accept: "application/vnd.github+json",
        Authorization: `Bearer ${jwt}`,
        "X-GitHub-Api-Version": "2022-11-28",
        "User-Agent": "pyohei-ai",
      },
    },
  );

  if (!response.ok) {
    fail(`${app.name}: ${response.status} ${await response.text()}`);
  }

  const body = await response.json();
  if (!body.token) fail(`${app.name}: response did not include a token`);
  return body.token;
}

function usage() {
  console.log(`Usage: pyohei-ai <command> [app]

Commands:
  token [app]   Print a GitHub App installation token (default: ${DEFAULT_APP})
  list          List configured apps
  help          Show this message

Apps are configured in ${CONFIG_DIR}/${APPS_DIR}/<app>.env with:
  GITHUB_APP_ID, GITHUB_APP_INSTALLATION_ID, GITHUB_APP_PRIVATE_KEY_PATH

Environment:
  PYOHEI_AI_APP             Default app name
  PYOHEI_AI_CONFIG_DIR      Override ${CONFIG_DIR}
  GITHUB_APP_CONFIG_PATH    Use this env file directly`);
}

async function main() {
  const [command = "token", ...rest] = process.argv.slice(2);

  switch (command) {
    case "token": {
      const appName = rest[0] || process.env.PYOHEI_AI_APP || DEFAULT_APP;
      const app = await loadApp(appName);
      process.stdout.write(await mintToken(app));
      return;
    }
    case "list": {
      const apps = await listApps();
      if (!apps.length) fail(`No apps configured under ${configDir()}`);
      for (const name of apps) {
        const app = await loadApp(name);
        console.log(`${name}\tapp_id=${app.appId}\tinstallation_id=${app.installationId}`);
      }
      return;
    }
    case "help":
    case "-h":
    case "--help":
      usage();
      return;
    default:
      fail(`Unknown command "${command}". Run \`pyohei-ai help\`.`);
  }
}

main().catch((err) => fail(err.message));
